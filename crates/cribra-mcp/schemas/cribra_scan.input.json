{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cribra.dev/schemas/mcp/cribra_scan.input.json",
  "title": "cribra_scan input",
  "type": "object",
  "additionalProperties": false,
  "required": ["source"],
  "properties": {
    "source": {
      "type": "string",
      "maxLength": 1048576,
      "description": "UTF-8 text to scan. The server enforces a 1 MiB UTF-8 byte limit; maxLength is a coarse client-side guard."
    },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "description": "Optional custom regular-expression rules added to the built-in ruleset.",
      "items": { "$ref": "#/$defs/customRule" }
    }
  },
  "$defs": {
    "customRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        }
      }
    }
  }
}

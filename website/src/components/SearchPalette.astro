---
import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const items = [
  ...docs.map((doc) => ({
    title: doc.data.title,
    description: doc.data.description,
    category: 'Docs',
    href: withBase(`/docs/${doc.id}/`),
  })),
  {
    title: 'Language integrations',
    description: 'Bindings, compatibility, qualification, and distribution',
    category: 'Reference',
    href: withBase('/bindings/'),
  },
  {
    title: 'Swift Core API reference',
    description: 'Generated Swift-DocC reference for Cribra 0.7.2 Core',
    category: 'Reference',
    href: withBase('/api/0.7.2/swift/core/documentation/cribra/'),
  },
  {
    title: 'Examples',
    description: 'Rust scanning, transformation, CLI, and WebAssembly examples',
    category: 'Examples',
    href: withBase('/examples/'),
  },
  {
    title: 'Documentation',
    description: 'All guides and topics',
    category: 'Index',
    href: withBase('/docs/'),
  },
  {
    title: 'Cribra',
    description: 'Sensitive data. Under control.',
    category: 'Home',
    href: withBase('/'),
  },
];
---

<dialog
  class="search-palette"
  data-search-palette
  aria-label="Search Cribra"
  data-pagefind-ignore="all"
>
  <div class="search-palette-panel">
    <div class="search-palette-field">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="m14.2 14.2 3.1 3.1"></path>
        <circle cx="8.6" cy="8.6" r="5.6"></circle>
      </svg>
      <input
        type="search"
        data-search-palette-input
        placeholder="Find a page · full text at /search/"
        autocomplete="off"
        aria-label="Search page titles and descriptions"
      />
      <button
        class="search-palette-close"
        type="button"
        data-search-palette-close
        aria-label="Close search"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5 5 15"></path>
        </svg>
      </button>
    </div>

    <div class="search-palette-results" data-search-palette-results aria-live="polite"></div>
    <a class="full-search" href="/search/">Search full documentation and examples →</a>
  </div>
</dialog>

<script
  is:inline
  type="application/json"
  id="search-palette-data"
  set:html={serializeScriptJson(items)}
/>

<script>
  import { mountSearchPaletteTriggers } from '../scripts/search-palette-loader';

  mountSearchPaletteTriggers();
</script>

<style>
  .search-palette {
    width: min(38rem, calc(100vw - 2rem));
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--label-primary);
    overflow: visible;
  }

  .search-palette::backdrop {
    background: rgba(4, 8, 11, 0.45);
  }

  .search-palette-panel {
    border: 1px solid color-mix(in srgb, var(--separator) 70%, transparent);
    border-radius: var(--radius-xl);
    background: var(--bg-primary);
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .full-search {
    display: block;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--separator);
    color: var(--color-blue);
    font-size: var(--text-footnote);
  }

  .search-palette-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 4rem;
    padding: 0 var(--space-5);
    border-bottom: 1px solid var(--separator);
  }

  .search-palette-field svg {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-blue);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .search-palette-field input {
    width: 100%;
    border: 0;
    appearance: textfield;
    outline: 0;
    background: transparent;
    color: var(--label-primary);
    font: inherit;
    font-size: var(--text-callout);
    font-weight: var(--weight-medium);
  }

  .search-palette-field input::placeholder {
    color: var(--label-tertiary);
  }

  .search-palette-field input::-webkit-search-cancel-button,
  .search-palette-field input::-webkit-search-decoration {
    width: 0;
    height: 0;
    display: none;
    -webkit-appearance: none;
  }

  .search-palette-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--label-tertiary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .search-palette-close:hover,
  .search-palette-close:focus-visible {
    background: var(--fill-tertiary);
    color: var(--label-primary);
  }

  .search-palette-close svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
  }

  .search-palette-results {
    display: grid;
    gap: 1px;
    padding: var(--space-2);
  }

  .search-palette-results :global(.search-palette-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .search-palette-results :global(.search-palette-item:hover),
  .search-palette-results :global(.search-palette-item.is-active) {
    background: var(--fill-tertiary);
    opacity: 1;
  }

  .search-palette-results :global(.search-palette-item-main) {
    min-width: 0;
    display: grid;
    gap: var(--space-1);
  }

  .search-palette-results :global(.search-palette-item-title) {
    overflow: hidden;
    color: var(--label-primary);
    font-size: var(--text-callout);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-palette-results :global(.search-palette-item-desc) {
    overflow: hidden;
    color: var(--label-tertiary);
    font-size: var(--text-footnote);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-palette-results :global(.search-palette-item-meta) {
    color: var(--color-blue);
    font-size: var(--text-caption-1);
    font-weight: var(--weight-accent-label);
    white-space: nowrap;
  }

  .search-palette-results :global(.search-palette-empty) {
    margin: 0;
    padding: var(--space-6) var(--space-4);
    color: var(--label-tertiary);
    font-size: var(--text-footnote);
    text-align: center;
  }

  @media (max-width: 600px) {
    .search-palette {
      width: calc(100vw - 1rem);
    }

    .search-palette-field {
      min-height: 3.5rem;
      padding: 0 var(--space-4);
    }

    .search-palette-results :global(.search-palette-item) {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>

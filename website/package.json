{
  "name": "cribra-website",
  "description": "The official Cribra website and documentation",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Cribra contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Metalymph/cribra.git",
    "directory": "website"
  },
  "bugs": {
    "url": "https://github.com/Metalymph/cribra/issues"
  },
  "homepage": "https://cribra.pages.dev",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md,mdx}\"",
    "lint": "eslint \"src/**/*.{js,ts,astro}\" \"*.mjs\"",
    "lint:css": "stylelint \"src/**/*.{css,astro}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "astro-expressive-code": "^0.44.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "overrides": {
    "@typescript-eslint/scope-manager": "8.46.3",
    "@typescript-eslint/types": "8.46.3",
    "@typescript-eslint/visitor-keys": "8.46.3",
    "postcss-selector-parser": "^7.1.6",
    "yaml-language-server": {
      "yaml": "2.8.4"
    }
  }
}

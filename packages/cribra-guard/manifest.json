{
  "manifest_version": 3,
  "name": "Cribra Guard Host Qualification",
  "version": "0.0.0",
  "description": "Qualification-only MV3 service worker hosting the Cribra Flow WebAssembly scanner.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [],
  "host_permissions": []
}

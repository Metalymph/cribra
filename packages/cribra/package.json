{
  "name": "@metalymph/cribra",
  "version": "0.1.0",
  "description": "ESM-only TypeScript bindings for the Cribra WebAssembly scanner",
  "type": "module",
  "cribraRelease": {
    "approvedName": "@metalymph/cribra",
    "state": "approved",
    "tagPrefix": "typescript-v",
    "distTag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "Cribra contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Metalymph/cribra.git",
    "directory": "packages/cribra"
  },
  "bugs": {
    "url": "https://github.com/Metalymph/cribra/issues"
  },
  "homepage": "https://cribra.pages.dev",
  "keywords": [
    "cribra",
    "secrets",
    "scanner",
    "redaction",
    "wasm",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate:version": "node scripts/generate-version.mjs",
    "build:wasm": "node scripts/build-wasm.mjs --profile flow --out src/wasm",
    "build": "node scripts/build.mjs",
    "build:core": "node scripts/build.mjs --profile core",
    "check": "node scripts/generate-version.mjs && node scripts/build-wasm.mjs --profile flow --out src/wasm && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:types": "node scripts/generate-test-types.mjs && tsc -p tsconfig.test.json",
    "package:check": "node scripts/package-check.mjs",
    "package:check:release": "node scripts/package-check.mjs --release",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:stage-check": "node scripts/release-stage-check.mjs",
    "qualify": "node scripts/qualify.mjs",
    "qualify:pack": "node qualification/scripts/pack.mjs --repeat",
    "qualify:node": "node qualification/scripts/node-consumer.mjs",
    "qualify:typescript": "node qualification/scripts/typescript-consumer.mjs",
    "qualify:browser": "node qualification/scripts/browser-consumer.mjs",
    "qualify:vite": "node qualification/scripts/vite-consumer.mjs",
    "qualify:webpack": "node qualification/scripts/webpack-consumer.mjs",
    "qualify:safari": "node qualification/scripts/safari-native.mjs",
    "qualify:consumers": "node qualification/scripts/all.mjs --skip-pack",
    "qualify:all": "node qualification/scripts/all.mjs --repeat"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
